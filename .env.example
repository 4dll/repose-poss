# Supabase → Project Settings → Database → Connection string (URI)
# Use "Transaction" pooler mode for Vercel serverless.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Private publishing key: generate with `openssl rand -hex 32`.
# Set only on the API server / Vercel, then enter it once on the POS Menu QR page.
# Never prefix this secret with VITE_ or include it in a QR code.
MENU_PUBLISH_KEY=

# Optional public website origin for locally served POS builds.
# VITE_MENU_ORIGIN=https://repose-poss.vercel.app

# Local dev (optional)
PORT=3002
HOST=0.0.0.0
